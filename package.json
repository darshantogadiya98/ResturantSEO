{
  "name": "restaurantguard-ai",
  "version": "1.0.0",
  "description": "AI-powered crisis response system for restaurant SEO",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:load": "node tests/load/load-test.js",
    "build": "npm run build:lambda",
    "build:lambda": "node scripts/build-lambda.js",
    "deploy": "scripts/deployment/deploy.sh",
    "dev": "nodemon src/api/server.js",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js",
    "docs:setup": "node scripts/docs-sync/setup.js",
    "docs:sync": "node scripts/docs-sync/sync-google-doc.js",
    "docs:webhook": "node scripts/docs-sync/webhook-server.js",
    "docs:demo": "node scripts/docs-sync/demo.js"
  },
  "keywords": [
    "restaurant",
    "seo",
    "ai",
    "bedrock",
    "aws",
    "crisis-response",
    "automation"
  ],
  "author": "RestaurantGuard AI Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "aws-sdk": "^2.1491.0",
    "@aws-sdk/client-bedrock-runtime": "^3.441.0",
    "@aws-sdk/client-rds-data": "^3.441.0",
    "@aws-sdk/client-s3": "^3.441.0",
    "@aws-sdk/client-secrets-manager": "^3.441.0",
    "@octokit/rest": "^20.0.2",
    "axios": "^1.5.1",
    "express": "^4.18.2",
    "fastify": "^4.24.3",
    "googleapis": "^128.0.0",
    "stripe": "^14.5.0",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "eslint": "^8.52.0",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3",
    "aws-sdk-mock": "^5.8.0",
    "nock": "^13.3.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}